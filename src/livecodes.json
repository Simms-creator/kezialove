  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>💖 Love Calculator 💖</title>\n    <script crossorigin src=\"https://unpkg.com/react@18/umd/react.production.min.js\"></script>\n    <script crossorigin src=\"https://unpkg.com/react-dom@18/umd/react-dom.production.min.js\"></script>\n    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        }\n\n        .love-calculator-wrapper {\n            min-height: 100vh;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 20px;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .love-calculator {\n            background: linear-gradient(135deg, #ffffff 0%, #fef5f7 100%);\n            border-radius: 24px;\n            padding: 50px 45px;\n            max-width: 480px;\n            width: 100%;\n            box-shadow: \n                0 20px 60px rgba(0, 0, 0, 0.15),\n                0 0 1px rgba(0, 0, 0, 0.1);\n            backdrop-filter: blur(10px);\n            position: relative;\n            z-index: 10;\n            animation: blobbyMorph 6s ease-in-out infinite;\n        }\n\n        @keyframes blobbyMorph {\n            0%, 100% {\n                border-radius: 24px 24px 24px 24px;\n            }\n            25% {\n                border-radius: 30px 20px 28px 22px;\n            }\n            50% {\n                border-radius: 20px 30px 22px 28px;\n            }\n            75% {\n                border-radius: 28px 22px 20px 30px;\n            }\n        }\n\n        .header {\n            text-align: center;\n            margin-bottom: 35px;\n        }\n\n        .header h1 {\n            font-size: 32px;\n            background: linear-gradient(135deg, #ff1493 0%, #ff69b4 100%);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: 8px;\n            font-weight: 700;\n        }\n\n        .subtitle {\n            color: #999;\n            font-size: 14px;\n            font-weight: 500;\n            letter-spacing: 0.5px;\n        }\n\n        .form {\n            display: flex;\n            flex-direction: column;\n            gap: 18px;\n            margin-bottom: 30px;\n        }\n\n        .input-wrapper {\n            display: flex;\n            flex-direction: column;\n            gap: 8px;\n        }\n\n        .input-wrapper label {\n            font-size: 13px;\n            font-weight: 600;\n            color: #333;\n            text-transform: uppercase;\n            letter-spacing: 0.8px;\n        }\n\n        .input-wrapper input {\n            padding: 14px 16px;\n            border: 2px solid #e8e8e8;\n            border-radius: 12px;\n            font-size: 15px;\n            transition: all 0.3s ease;\n            background: #fafafa;\n            font-family: inherit;\n        }\n\n        .input-wrapper input:focus {\n            outline: none;\n            border-color: #ff1493;\n            background: #fff;\n            box-shadow: 0 0 0 3px rgba(255, 20, 147, 0.1);\n        }\n\n        .input-wrapper input:disabled {\n            opacity: 0.6;\n            cursor: not-allowed;\n        }\n\n        .calculate-btn {\n            padding: 16px 32px;\n            background: linear-gradient(135deg, #ff1493 0%, #ff69b4 100%);\n            color: white;\n            border: none;\n            border-radius: 50px;\n            font-size: 16px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 10px;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            margin-top: 10px;\n            position: relative;\n            overflow: hidden;\n            animation: blobbyPulse 3s ease-in-out infinite;\n        }\n\n        @keyframes blobbyPulse {\n            0%, 100% {\n                border-radius: 50px;\n                transform: scale(1);\n            }\n            25% {\n                border-radius: 45% 55% 52% 48% / 48% 45% 55% 52%;\n                transform: scale(1.02);\n            }\n            50% {\n                border-radius: 55% 45% 48% 52% / 52% 48% 45% 55%;\n                transform: scale(1.04);\n            }\n            75% {\n                border-radius: 48% 52% 45% 55% / 55% 52% 48% 45%;\n                transform: scale(1.02);\n            }\n        }\n\n        .calculate-btn:hover:not(:disabled) {\n            transform: translateY(-2px);\n            box-shadow: 0 12px 24px rgba(255, 20, 147, 0.4);\n            animation: blobbyPulse 1.5s ease-in-out infinite;\n        }\n\n        .calculate-btn:active:not(:disabled) {\n            transform: translateY(0) scale(0.98);\n            animation: none;\n        }\n\n        .calculate-btn:disabled {\n            opacity: 0.8;\n            cursor: not-allowed;\n        }\n\n        .spinner {\n            width: 16px;\n            height: 16px;\n            border: 2px solid rgba(255, 255, 255, 0.3);\n            border-top-color: white;\n            border-radius: 50%;\n            animation: spin 0.8s linear infinite;\n            display: inline-block;\n        }\n\n        @keyframes spin {\n            to { transform: rotate(360deg); }\n        }\n\n        .result-section {\n            animation: slideUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);\n        }\n\n        @keyframes slideUp {\n            from {\n                opacity: 0;\n                transform: translateY(20px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .score-display {\n            text-align: center;\n            padding: 30px 20px;\n            background: linear-gradient(135deg, rgba(255, 20, 147, 0.08) 0%, rgba(255, 105, 180, 0.08) 100%);\n            border-radius: 16px;\n            border: 2px solid rgba(255, 20, 147, 0.2);\n        }\n\n        .percentage {\n            font-size: 72px;\n            font-weight: 800;\n            line-height: 1;\n            margin-bottom: 16px;\n        }\n\n        .message {\n            font-size: 18px;\n            font-weight: 600;\n            color: #333;\n        }\n\n        .error-message {\n            color: #e74c3c;\n            text-align: center;\n            font-size: 14px;\n            padding: 12px;\n            background: rgba(231, 76, 60, 0.1);\n            border-radius: 8px;\n            margin-top: 16px;\n        }\n\n        .hearts-container {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 5;\n        }\n\n        .floating-heart {\n            position: absolute;\n            bottom: 0;\n            animation: float forwards linear;\n            user-select: none;\n        }\n\n        @keyframes float {\n            0% {\n                opacity: 1;\n                transform: translateY(0) scale(1) rotate(0deg);\n            }\n            100% {\n                opacity: 0;\n                transform: translateY(-100vh) scale(1.2) rotate(360deg);\n            }\n        }\n\n        @media (max-width: 600px) {\n            .love-calculator {\n                padding: 40px 25px;\n            }\n\n            .header h1 {\n                font-size: 28px;\n            }\n\n            .percentage {\n                font-size: 56px;\n            }\n\n            .message {\n                font-size: 16px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"root\"></div>\n\n    <script type=\"text/babel\">\n        const { useState, useRef } = React;\n\n        function LoveCalculator() {\n            const [name1, setName1] = useState('');\n            const [name2, setName2] = useState('');\n            const [score, setScore] = useState(null);\n            const [loading, setLoading] = useState(false);\n            const [hearts, setHearts] = useState([]);\n            const heartIdRef = useRef(0);\n\n            const getCharSum = (str) => {\n                let sum = 0;\n                for (let i = 0; i < str.length; i++) {\n                    sum += str.charCodeAt(i);\n                }\n                return sum;\n            };\n\n            const createHeartFirework = (count) => {\n                const newHearts = [];\n                const colors = ['#ff1493', '#ff69b4', '#ff85b8', '#ffb6c1', '#ff6f91'];\n                \n                for (let i = 0; i < count; i++) {\n                    const id = heartIdRef.current++;\n                    newHearts.push({\n                        id,\n                        left: Math.random() * 100,\n                        color: colors[Math.floor(Math.random() * colors.length)],\n                        size: 15 + Math.random() * 35,\n                        duration: 1.5 + Math.random() * 0.5,\n                    });\n                }\n                \n                setHearts((prev) => [...prev, ...newHearts]);\n                \n                setTimeout(() => {\n                    setHearts((prev) =>\n                        prev.filter((h) => !newHearts.some((nh) => nh.id === h.id))\n                    );\n                }, 2500);\n            };\n\n            const handleCalculate = () => {\n                const trimmed1 = name1.trim().toLowerCase();\n                const trimmed2 = name2.trim().toLowerCase();\n\n                if (!trimmed1 || !trimmed2) {\n                    setScore({ value: 0, message: 'Please enter both names' });\n                    return;\n                }\n\n                setLoading(true);\n                setScore(null);\n                \n                setTimeout(() => {\n                    const sum1 = getCharSum(trimmed1);\n                    const sum2 = getCharSum(trimmed2);\n                    const totalNum = sum1 * sum2;\n                    const finalScore = totalNum % 100;\n\n                    setScore({ value: finalScore, message: null });\n                    setLoading(false);\n\n                    const heartCount = finalScore >= 80 ? 40 : 20;\n                    createHeartFirework(heartCount);\n                }, 800);\n            };\n\n            const getScoreMessage = (score) => {\n                if (score >= 90) return \"🚀 DESTINY WRITTEN IN THE STARS!\";\n                if (score >= 80) return \"💕 An extraordinary love!\";\n                if (score >= 70) return \"❤️ Strong connection!\";\n                if (score >= 60) return \"💗 Good potential!\";\n                if (score >= 50) return \"💓 There's a spark!\";\n                if (score >= 40) return \"💙 Room to grow...\";\n                if (score >= 30) return \"🤝 Just friends vibe\";\n                if (score >= 20) return \"😅 Maybe not meant to be\";\n                return \"👋 Better as friends!\";\n            };\n\n            const getScoreColor = (score) => {\n                if (score >= 80) return '#ff1493';\n                if (score >= 60) return '#ff69b4';\n                if (score >= 40) return '#ff85b8';\n                return '#ffb6c1';\n            };\n\n            return (\n                <div className=\"love-calculator-wrapper\">\n                    <div className=\"love-calculator\">\n                        <div className=\"header\">\n                            <h1>💖 Love Calculator 💖</h1>\n                            <p className=\"subtitle\">Discover your connection</p>\n                        </div>\n\n                        <div className=\"form\">\n                            <div className=\"input-wrapper\">\n                                <label htmlFor=\"name1\">Person 1</label>\n                                <input\n                                    id=\"name1\"\n                                    type=\"text\"\n                                    value={name1}\n                                    onChange={(e) => setName1(e.target.value)}\n                                    placeholder=\"Enter their name...\"\n                                    disabled={loading}\n                                />\n                            </div>\n\n                            <div className=\"input-wrapper\">\n                                <label htmlFor=\"name2\">Person 2</label>\n                                <input\n                                    id=\"name2\"\n                                    type=\"text\"\n                                    value={name2}\n                                    onChange={(e) => setName2(e.target.value)}\n                                    placeholder=\"Enter their name...\"\n                                    disabled={loading}\n                                />\n                            </div>\n\n                            <button onClick={handleCalculate} disabled={loading} className=\"calculate-btn\">\n                                {loading ? (\n                                    <>\n                                        <span className=\"spinner\"></span>\n                                        Calculating...\n                                    </>\n                                ) : (\n                                    'Calculate Love'\n                                )}\n                            </button>\n                        </div>\n\n                        {score && (\n                            <div className=\"result-section\">\n                                <div className=\"score-display\" style={{ color: getScoreColor(score.value) }}>\n                                    <div className=\"percentage\">{score.value}%</div>\n                                    <div className=\"message\">{getScoreMessage(score.value)}</div>\n                                </div>\n                            </div>\n                        )}\n\n                        {score?.message && (\n                            <div className=\"error-message\">{score.message}</div>\n                        )}\n                    </div>\n\n                    <div className=\"hearts-container\">\n                        {hearts.map((heart) => (\n                            <div\n                                key={heart.id}\n                                className=\"floating-heart\"\n                                style={{\n                                    left: `${heart.left}%`,\n                                    color: heart.color,\n                                    fontSize: `${heart.size}px`,\n                                    animationDuration: `${heart.duration}s`,\n                                }}\n                            >\n                                ❤️\n                            </div>\n                        ))}\n                    </div>\n                </div>\n            );\n        }\n\n        ReactDOM.render(<LoveCalculator />, document.getElementById('root'));\n    </script>\n</body>\n</html>"
  },
