  "head": "<base href=\"https://cdn.jsdelivr.net/gh/Simms-creator/kezialove@gh-pages/src/index.html\">\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
