    "language": "html",
    "content": "<!-- Love Calculator Widget with Colorful Heart Fireworks -->\n<div class=\"love-card\">\n  <h2>💖 Love Calculator 💖</h2>\n  <div class=\"input-group\">\n    <label for=\"cnameone\">Name of Person 1</label>\n    <input type=\"text\" id=\"cnameone\" name=\"cnameone\" placeholder=\"Enter first name\">\n  </div>\n  <div class=\"input-group\">\n    <label for=\"cnametwo\">Name of Person 2</label>\n    <input type=\"text\" id=\"cnametwo\" name=\"cnametwo\" placeholder=\"Enter second name\">\n  </div>\n  <button onclick=\"calc()\">Calculate</button>\n  <div id=\"coutput\" class=\"result\"></div>\n  <div id=\"hearts\"></div>\n  <p class=\"credit\">powered by <a href=\"https://simms-creator.github.io/innojar-html/\" rel=\"nofollow\">innojar coporation</a></p>\n</div>\n\n<style>\n/* Card Container */\n.love-card {\n  max-width: 400px;\n  margin: 40px auto;\n  padding: 25px 30px;\n  background: linear-gradient(135deg, #ffdde1, #ee9ca7);\n  border-radius: 15px;\n  box-shadow: 0 8px 20px rgba(0,0,0,0.2);\n  font-family: Arial, Helvetica, sans-serif;\n  text-align: center;\n  position: relative;\n  overflow: hidden;\n}\n\n/* Card Title */\n.love-card h2 {\n  margin-bottom: 20px;\n  font-size: 24px;\n  color: #fff;\n  text-shadow: 1px 1px 3px rgba(0,0,0,0.3);\n}\n\n/* Input Groups */\n.input-group {\n  margin-bottom: 15px;\n  text-align: left;\n}\n\n.input-group label {\n  display: block;\n  margin-bottom: 5px;\n  color: #fff;\n  font-weight: bold;\n}\n\n.input-group input {\n  width: 100%;\n  padding: 10px;\n  border-radius: 8px;\n  border: none;\n  outline: none;\n  font-size: 14px;\n}\n\n/* Button */\nbutton {\n  padding: 10px 25px;\n  background-color: #ff6f91;\n  border: none;\n  border-radius: 8px;\n  color: #fff;\n  font-weight: bold;\n  font-size: 16px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\nbutton:hover {\n  background-color: #ff3c6e;\n}\n\n/* Result Styling */\n.result {\n  margin-top: 20px;\n  font-size: 28px;\n  font-weight: bold;\n}\n\n/* Hearts */\n#hearts {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  overflow: visible;\n}\n\n.heart {\n  position: absolute;\n  opacity: 0.9;\n  animation: float 1.5s ease-out forwards;\n}\n\n@keyframes float {\n  0% { transform: translateY(0) scale(1); opacity: 1; }\n  100% { transform: translateY(-80px) scale(1.5); opacity: 0; }\n}\n\n/* Credit */\n.credit {\n  margin-top: 15px;\n  font-size: 12px;\n  color: #fff;\n}\n.credit a {\n  color: #fff;\n  text-decoration: underline;\n}\n</style>\n\n<script>\n/*****************************************\n(C) https://www.calculator.net all right reserved.\n*****************************************/\nfunction gObj(B){var A;if(document.all){if(typeof B==\"string\"){return document.all(B)}else{return B.style}}if(document.getElementById){if(typeof B==\"string\"){return document.getElementById(B)}else{return B.style}}return null}\nfunction showquickmsg(B,A){if(A){B=\"<font color=red>\"+B+\"</font>\"}gObj(\"coutput\").innerHTML=B}\nfunction trimAll(A){while(A.substring(0,1)==\" \"){A=A.substring(1,A.length)}while(A.substring(A.length-1,A.length)==\" \"){A=A.substring(0,A.length-1)}return A}\nfunction getNum(A){outputNum=0;for(i=0;i<A.length;i++){outputNum+=A.charCodeAt(i)}return outputNum}\n\n// Create a single heart with random size and color\nfunction createHeart() {\n  var h = document.createElement(\"div\");\n  h.className = \"heart\";\n  h.innerHTML = \"❤️\";\n  h.style.left = Math.random() * 90 + \"%\";\n  h.style.fontSize = (15 + Math.random()*25) + \"px\"; // random size 15-40px\n  var colors = [\"#ff3c6e\",\"#ff6f91\",\"#ffb6c1\",\"#ff1493\"];\n  h.style.color = colors[Math.floor(Math.random()*colors.length)];\n  document.getElementById(\"hearts\").appendChild(h);\n  setTimeout(()=>h.remove(),1500);\n}\n\n// Create multiple hearts, optionally more for fireworks\nfunction createHearts(num){\n  for(let i=0;i<num;i++){\n    setTimeout(createHeart,i*50);\n  }\n}\n\nfunction calc(){\n  showquickmsg(\"calculating...\",true);\n  cnameone = trimAll(gObj(\"cnameone\").value);\n  cnametwo = trimAll(gObj(\"cnametwo\").value);\n  if(cnameone.length<1){ showquickmsg(\"please provide name one\",true); return }\n  if(cnametwo.length<1){ showquickmsg(\"please provide name two\",true); return }\n\n  cnameone = cnameone.toLowerCase();\n  cnametwo = cnametwo.toLowerCase();\n  totalNum = getNum(cnameone)*getNum(cnametwo);\n  finalScore = totalNum % 100;\n  finalScoreHTML = \"<h1><font color=green><b>\"+finalScore+\"%</b></font></h1>\";\n  showquickmsg(finalScoreHTML,false);\n\n  // Hearts animation\n  if(finalScore >= 80){\n    // Fireworks effect: 30 colorful hearts for high love %\n    createHearts(30);\n  } else {\n    // Normal: 15 hearts\n    createHearts(15);\n  }\n};\n</script>"
  },
